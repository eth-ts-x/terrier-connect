{
  "name": "elasticsearch-post-sink",
  "config": {
    "connector.class": "io.confluent.connect.elasticsearch.ElasticsearchSinkConnector",
    "tasks.max": "1",
    "topics": "cassandra.terrier.post_by_id",
    "connection.url": "http://elasticsearch:9200",
    "type.name": "_doc",
    "key.ignore": false,
    "schema.ignore": true,
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": false,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": false,
    "transforms": "extractKey,renameIndex",
    "transforms.extractKey.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.extractKey.field": "post_id",
    "transforms.renameIndex.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.renameIndex.regex": ".*",
    "transforms.renameIndex.replacement": "posts",
    "behavior.on.null.values": "delete",
    "behavior.on.malformed.documents": "warn",
    "write.method": "upsert",
    "batch.size": 100,
    "max.buffered.records": 500,
    "flush.timeout.ms": 10000,
    "max.retries": 5,
    "retry.backoff.ms": 1000,
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dlq-elasticsearch-posts",
    "errors.deadletterqueue.topic.replication.factor": 1,
    "errors.log.enable": true,
    "errors.log.include.messages": true
  }
}
