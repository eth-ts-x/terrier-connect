# Copy this file to cluster-vars.env and fill in your values for local development.
# In CI/CD (Cloud Build), this file is rendered automatically from cluster-vars.env.tmpl.
DOMAIN_NAME=your-domain.com
WWW_DOMAIN_NAME=www.your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CLOUDSQL_INSTANCE=your-project-id:us-central1:terrier-connect-db
GS_PROJECT_ID=your-project-id
GKE_SA_EMAIL=terrier-connect-gke-sa@your-project-id.iam.gserviceaccount.com
